# Change every placeholder secret before production deployment.
BIRDBOX_IMAGE_TAG=0.01a
MYSQL_DATABASE=birdbox
MYSQL_USER=birdbox
MYSQL_PASSWORD=change-this-birdbox-password
MYSQL_ROOT_PASSWORD=change-this-root-password
BIRDBOX_BIND_ADDRESS=127.0.0.1
BIRDBOX_PORT=3000
# Set true when HTTPS terminates inside the Node process or at a trusted proxy.
BIRDBOX_SECURE_COOKIE=false
# Allow an in-flight remote deployment to finish before the container is stopped.
BIRDBOX_SHUTDOWN_TIMEOUT_MS=1800000
