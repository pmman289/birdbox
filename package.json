{
  "name": "birdbox-demo",
  "version": "0.15a",
  "private": true,
  "description": "A BIRD 2 node, peer, and BGP session management controller",
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run typecheck:web && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "test": "NODE_OPTIONS=--import=tsx node --test test/*.test.js",
    "test:e2e": "playwright test",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:web": "vue-tsc --noEmit -p apps/web/tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "fastify": "^5.11.3",
    "mysql2": "^3.23.2",
    "pinyin-pro": "3.28.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "5.2.4",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vue": "3.5.41",
    "vue-tsc": "3.3.9"
  }
}
