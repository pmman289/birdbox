{
  "name": "birdbox",
  "version": "0.38.0-alpha.16",
  "private": true,
  "description": "A BIRD 2 node, peer, and BGP session management controller",
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run typecheck:web && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "test": "NODE_OPTIONS=--import=tsx node --test --test-concurrency=1 test/*.test.js",
    "test:e2e": "playwright test",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:web": "vue-tsc --noEmit -p apps/web/tsconfig.json",
    "demo:ospf": "npm run build:web && tsx scripts/ospf-demo.ts",
    "demo:static": "npm run build:web && tsx scripts/static-demo.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "5.2.4",
    "pinyin-pro": "3.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  }
}
